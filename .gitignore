# Unreal Engine generated/cache folders
Binaries/
Intermediate/
DerivedDataCache/
Saved/
.vs/
Build/

# Visual Studio / Rider generated project files (regenerated from .uproject)
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Scratch space for downloaded/generated assets before import (not part of the project)
meshy/

# OS files
.DS_Store
Thumbs.db

# scratch assets used by the heightmap import pipeline
Content/Timeshift/Environment/Terrain/_Import/

# Captures and renders. Screenshots/.gitkeep is tracked so the folder survives.
Screenshots/*
!Screenshots/.gitkeep
*.mp4
*.mov

# Unreal writes this when you change the .uproject engine association
*.uproject.bak

# Blender's rolling backup copies - the .blend itself is tracked
*.blend1
*.blend2

# Raw third-party downloads and their regenerable prep output (re-download / re-run prep scripts)
SourceArt/Environment/Arena/dl_*/
SourceArt/Environment/Arena/prep/

# Trailer production (render frames, videos, voice-over) - large, kept out of the repo
/Trailer/
