(fn UpdateWading ()
  ; wading: slower the deeper the water; ring ripples in the water (MPC_Wading -> M_SwampPond), light spray + slosh sounds while moving
  (Variables|Default|SetWaterDepth 0.0)
  (bind arr (Actor|GetAllActorswithTag :Tag "Water"))
  (for a arr
    (CallFunction|ConsiderWater self a))
  (bind depth (Variables|Default|GetWaterDepth))
  (bind base (select (> (Variables|Default|GetBaseWalkSpeed) 0.0) (Variables|Default|GetBaseWalkSpeed) 500.0))
  (if (not (Variables|Default|GetIsAttacking))
    (Class|CharacterMovementComponent|SetMaxWalkSpeed :self (Variables|Character|GetCharacterMovement) :MaxWalkSpeed (* (* base (Math|Float|MapRangeClamped depth 15.0 115.0 1.0 0.45)) (* (select (> (Variables|Default|GetHazardSpeedMult) 0.0) (Variables|Default|GetHazardSpeedMult) 1.0) (- 1.0 (* 0.6 (Variables|Default|GetSink)))))))
  (CallFunction|EnsureSplash self)
  (CallFunction|EnsureFoam self)
  (Rendering|SetVisibility (Variables|Default|GetFoamComponent) false)
  (bind sp (Variables|Default|GetSplashComponent))
  (bind loc (Transformation|GetActorLocation self))
  (bind spd (Math|Vector|VectorLengthXY (Transformation|GetVelocity self)))
  (bind target (select (> depth 12.0) (Math|Float|MapRangeClamped spd 0.0 350.0 0.25 1.0) 0.0))
  (Variables|Default|SetRippleStrength (Math|Interpolation|FInterpTo (Variables|Default|GetRippleStrength) target 0.05 6.0))
  (Rendering|Material|SetVectorParameterValue :Collection "/Game/Timeshift/Environment/Water/MPC_Wading.MPC_Wading" :ParameterName "PlayerPos" :ParameterValue (Math|Conversions|ToLinearColor(Vector) loc))
  (Rendering|Material|SetScalarParameterValue :Collection "/Game/Timeshift/Environment/Water/MPC_Wading.MPC_Wading" :ParameterName "RippleStrength" :ParameterValue (Variables|Default|GetRippleStrength))
  (if (and (> depth 12.0) (> spd 60.0))
    (Transformation|SetWorldLocation sp (Math|Vector|MakeVector (.x loc) (.y loc) (+ (Variables|Default|GetWaterSurfaceZ) 1.5)))
    (Components|Activation|Activate sp false)
    (CallFunction|PlaySloshIfDue self)
    (else
      (Components|Activation|Deactivate sp))))
