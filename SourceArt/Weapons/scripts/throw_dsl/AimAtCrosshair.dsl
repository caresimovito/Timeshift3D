(fn AimAtCrosshair ()
  ; aimed throw: no auto-aim target; aim point = what the screen-centre ray from the camera hits (or 120 m out)
  (Variables|Default|SetThrowTarget)
  (Variables|Default|SetAimedThrow true)
  (bind cam (Variables|Components|GetFollowCamera))
  (bind cl (Transformation|GetWorldLocation cam))
  (bind fw (Transformation|GetForwardVector cam))
  (Variables|Default|SetAimFar (Math|Vector|MakeVector (+ (.x cl) (* (.x fw) 12000.0)) (+ (.y cl) (* (.y fw) 12000.0)) (+ (.z cl) (* (.z fw) 12000.0))))
  (bind (hit ok) (Collision|LineTraceByChannel :Start cl :End (Variables|Default|GetAimFar)))
  (bind (bb io tm ds hl) (Collision|BreakHitResult hit))
  (Variables|Default|SetAimPoint (select ok hl (Variables|Default|GetAimFar))))
