(fn ConsiderWater (A)
  ; deepest water surface above the hero's feet among actors tagged "Water" (inside their XY bounds)
  (bind (o e) (Collision|GetActorBounds A false))
  (bind me (Transformation|GetActorLocation self))
  (bind feet (- (.z me) (select (Variables|Character|GetIsCrouched) 60.0 90.0)))
  (bind dx (- (.x me) (.x o)))
  (bind dy (- (.y me) (.y o)))
  (bind surface (+ (.z o) (.z e)))
  (bind depth (- surface feet))
  (if (and (and (< (* dx dx) (* (.x e) (.x e))) (< (* dy dy) (* (.y e) (.y e)))) (> depth (Variables|Default|GetWaterDepth)))
    (Variables|Default|SetWaterDepth depth)
    (Variables|Default|SetWaterSurfaceZ surface)))
