(fn LaunchStone ()
  (CallFunction|UpdateAimRotation self)
  (CallFunction|ComputeThrowRot self)
  (bind rot (Variables|Default|GetThrowRot))
  (bind hs (Variables|Default|GetHeldStoneComponent))
  (bind loc (Transformation|GetWorldLocation hs))
  (bind xf (Math|Transform|MakeTransform :Location (+ loc (* (Math|Vector|GetForwardVector rot) 25.0)) :Rotation rot))
  (Rendering|SetVisibility hs false)
  (Audio|PlaySoundAtLocation "/Game/Timeshift/Audio/SFX/Creatures/S_Fly_Dive_Whoosh.S_Fly_Dive_Whoosh" loc "0, 0, 0" 0.5 1.4)
  (if (Variables|Default|GetThrowingBola)
    (bind pb (Game|SpawnActorfromClass :Class "/Game/Timeshift/Weapons/BP_BolaProjectile.BP_BolaProjectile_C" :SpawnTransform xf :CollisionHandlingOverride "AlwaysSpawn" :Owner self))
    ; the hero must never collide with his own projectile (he could end up standing on it)
    (Collision|IgnoreActorWhenMoving (Variables|Character|GetCapsuleComponent) pb true)
    (Class|BPBolaProjectile|SetDamage :self pb :Damage (* 5.0 (select (Variables|Default|GetFuryActive) 2.0 1.0)))
    (Variables|Default|SetBolaCount (- (Variables|Default|GetBolaCount) 1))
    (Development|PrintString (Utilities|String|Append "Bolas left: " (Utilities|String|ToString(Integer) (Variables|Default|GetBolaCount))) true true "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" 1.5)
    (else
      (bind ps (Game|SpawnActorfromClass :Class "/Game/Timeshift/Weapons/BP_StoneProjectile.BP_StoneProjectile_C" :SpawnTransform xf :CollisionHandlingOverride "AlwaysSpawn" :Owner self))
      (Collision|IgnoreActorWhenMoving (Variables|Character|GetCapsuleComponent) ps true)
      (Class|BPStoneProjectile|SetDamage :self ps :Damage (* 22.0 (select (Variables|Default|GetFuryActive) 2.0 1.0)))
      (Variables|Default|SetStoneAmmo (- (Variables|Default|GetStoneAmmo) 1))
      (Development|PrintString (Utilities|String|Append "Stones left: " (Utilities|String|ToString(Integer) (Variables|Default|GetStoneAmmo))) true true "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" 1.5))))
