(fn EnsureBackWeapons ()
  ; weapons you own but are not holding ride on the back (spine_05), diagonally: spear tip up-left, club head up-right
  (Utilities|IsValid (Variables|Default|GetSpearBackComponent)
    (:"Is Valid")
    (:"Is Not Valid"
      (bind s (Game|AddComponentbyClass self "/Script/Engine.StaticMeshComponent"))
      (Variables|Default|SetSpearBackComponent s)
      (Components|StaticMesh|SetStaticMesh s "/Game/Timeshift/Weapons/Meshes/SM_Spear.SM_Spear")
      (Collision|SetCollisionEnabled s "NoCollision")
      (Transformation|AttachComponentToComponent s (Variables|Character|GetMesh) "spine_05" :LocationRule "SnapToTarget" :RotationRule "SnapToTarget" :ScaleRule "KeepRelative")
      (Transformation|SetRelativeLocationAndRotation s (Math|Vector|MakeVector -62.62 -10.56 40.11) (Math|Rotator|MakeRotator :Roll -118.14 :Pitch -22.81 :Yaw 88.99))
      (Transformation|SetRelativeScale3D s (Math|Vector|MakeVector 1.0 1.0 0.85))
      (Rendering|SetVisibility s false)
      (bind c (Game|AddComponentbyClass self "/Script/Engine.StaticMeshComponent"))
      (Variables|Default|SetClubBackComponent c)
      (Components|StaticMesh|SetStaticMesh c "/Game/Timeshift/Weapons/Meshes/SM_BoneClub.SM_BoneClub")
      (Collision|SetCollisionEnabled c "NoCollision")
      (Transformation|AttachComponentToComponent c (Variables|Character|GetMesh) "spine_05" :LocationRule "SnapToTarget" :RotationRule "SnapToTarget" :ScaleRule "KeepRelative")
      (Transformation|SetRelativeLocationAndRotation c (Math|Vector|MakeVector -10.06 -25.76 6.21) (Math|Rotator|MakeRotator :Roll 117.86 :Pitch -22.81 :Yaw 88.99))
      (Rendering|SetVisibility c false))))
