(fn PlaySloshIfDue ()
  (bind now (Utilities|Time|GetGameTimeinSeconds))
  (if (> now (Variables|Default|GetNextSloshTime))
    (Variables|Default|SetNextSloshTime (+ now 0.42))
    (bind loc (Transformation|GetActorLocation self))
    (switch int (Math|Random|RandomIntegerinRange 0 2)
      (:0 (Audio|PlaySoundAtLocation "/Game/Timeshift/Audio/SFX/Water/S_WaterSlosh_01.S_WaterSlosh_01" loc "0, 0, 0" 0.55 1.0))
      (:1 (Audio|PlaySoundAtLocation "/Game/Timeshift/Audio/SFX/Water/S_WaterSlosh_02.S_WaterSlosh_02" loc "0, 0, 0" 0.55 0.95))
      (:Default (Audio|PlaySoundAtLocation "/Game/Timeshift/Audio/SFX/Water/S_WaterSlosh_03.S_WaterSlosh_03" loc "0, 0, 0" 0.55 1.05)))))
