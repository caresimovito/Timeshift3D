(fn HandleDevPanels ()
  ; (moved off F1-F9 2026-10-23: those are Unreal's Play-mode view-mode keys - F5 = shader complexity)
  ; DEV PANELS (user 2026-10-23): 0 = list of keys, 9 = status - health, weapons, ammo, key piece, active power-ups and
  ; what has been picked up (PickupLog, filled by BP_InteractableBase). On-screen debug text: dev builds only
  (bind pc (Game|GetPlayerController 0))
  (bind f1 (Game|Player|IsInputKeyDown pc "Zero"))
  (if (and f1 (not (Variables|Default|GetHelpPressed)))
      (Development|PrintString :InString "Y where am I   T teleport zone   B mark blocked spot" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help9")
      (Development|PrintString :InString "POWER-UPS on/off: 4 fury  5 regen  6 adrenaline  7 hide  8 armour +25" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help10")
      (Development|PrintString :InString "K freeze enemies   O slow enemies   H health bars   N enemies can't see you" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help8")
      (Development|PrintString :InString "U morph: dino -> flyer -> human   G god mode   I give all weapons   L clear enemies" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help7")
      (Development|PrintString :InString "--- DEV keys (remove before release) ---" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help6")
      (Development|PrintString :InString "STATUS 9   KEYS 0" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help5")
      (Development|PrintString :InString "PICKUPS walk over them (E also works)   MORPH M (needs Morph Amber)   SETTINGS P   BESTIARY J   SCREENSHOT F12" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help4")
      (Development|PrintString :InString "KICK V   LOCK ON Q   WEAPONS 1 / 2 / 3, Tab cycles   TORCH on/off Z" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help3")
      (Development|PrintString :InString "ATTACK left click   AIM hold right mouse (+ left click = throw stone)   THROW STONE F or X   BOLA R" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help2")
      (Development|PrintString :InString "MOVE  W A S D / arrows   JUMP Space   CROUCH C   ZOOM mouse wheel / PgUp PgDn   CAMERA HEIGHT Home / End" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help1")
      (Development|PrintString :InString "=== KEYS (0) ===" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.700000,G=0.900000,B=1.000000,A=1.000000)" :Duration 15.0 :Key "Help0"))
  (Variables|Default|SetHelpPressed f1)
  (bind f2 (Game|Player|IsInputKeyDown pc "Nine"))
  (if (and f2 (not (Variables|Default|GetStatusPressed)))
      (Development|PrintString :InString (Utilities|String|Append "PICKED UP (newest first): " (Variables|Default|GetPickupLog)) :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" :Duration 12.0 :Key "Status5")
      (Development|PrintString :InString (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append "ACTIVE  fury " (select (Variables|Default|GetFuryActive) (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Float|Round (- (Variables|Default|GetFuryEnd) (Utilities|Time|GetGameTimeinSeconds)))) "s") "-")) "   regen ") (select (Variables|Default|GetRegenActive) (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Float|Round (- (Variables|Default|GetRegenEnd) (Utilities|Time|GetGameTimeinSeconds)))) "s") "-")) "   adrenaline ") (select (Variables|Default|GetAdrenaline) "yes" "no")) "   hide ") (select (Variables|Default|GetHiding) "yes" "no")) "   morphed ") (select (Variables|Default|GetMorphed) (Variables|Default|GetMorphName) "no")) :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" :Duration 12.0 :Key "Status4")
      (Development|PrintString :InString (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append "STONES " (Utilities|String|ToString(Integer) (Variables|Default|GetStoneAmmo))) "   BOLAS ") (Utilities|String|ToString(Integer) (Variables|Default|GetBolaCount))) "   KEY PIECES ") (Utilities|String|ToString(Integer) (Variables|Default|GetKeyPieces))) "   MORPH CHARGES ") (Utilities|String|ToString(Integer) (Variables|Default|GetMorphCharges))) :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" :Duration 12.0 :Key "Status3")
      (Development|PrintString :InString (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append "WEAPONS  spear " (select (Variables|Default|GetHasSpear) "yes" "no")) "   bone club ") (select (Variables|Default|GetHasBoneClub) "yes" "no")) "   torch ") (select (Variables|Default|GetHasTorch) (select (Variables|Default|GetTorchLit) "lit" "unlit") "no")) :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" :Duration 12.0 :Key "Status2")
      (Development|PrintString :InString (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append "HEALTH " (Utilities|String|ToString(Integer) (Math|Float|Round (Class|BPHealthComponent|GetCurrentHealth (Variables|Default|GetHealthComponent))))) " / ") (Utilities|String|ToString(Integer) (Math|Float|Round (Class|BPHealthComponent|GetMaxHealth (Variables|Default|GetHealthComponent))))) "   ARMOUR ") (Utilities|String|ToString(Integer) (Math|Float|Round (Class|BPHealthComponent|GetArmour (Variables|Default|GetHealthComponent))))) :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" :Duration 12.0 :Key "Status1")
      (Development|PrintString :InString "=== STATUS (9) ===" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.900000,B=0.500000,A=1.000000)" :Duration 12.0 :Key "Status0"))
  (Variables|Default|SetStatusPressed f2)
  ; DEV POWER-UP TOGGLES (user 2026-10-23: "test them without pickups, need an on / off option"): 4 Fury, 5 Regen,
  ; 6 Adrenaline, 7 Hide - on for 2 minutes, the same key turns it off early; 8 Armour +25 / back to 0 (not while morphed:
  ; the morph's health lives in the armour). REMOVE BEFORE RELEASE
  (bind kF5 (Game|Player|IsInputKeyDown pc "Four"))
  (if (and kF5 (not (Variables|Default|GetF5Pressed)))
    (if (Variables|Default|GetFuryActive)
      (Variables|Default|SetFuryEnd (Utilities|Time|GetGameTimeinSeconds))
      (Development|PrintString :InString "DEV 4: Fury OFF" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff")
      (else
        (CallFunction|StartFury self 120.0)
      (Development|PrintString :InString "DEV 4: Fury ON (2 min) - press 4 again to stop" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff"))))
  (Variables|Default|SetF5Pressed kF5)
  (bind kF6 (Game|Player|IsInputKeyDown pc "Five"))
  (if (and kF6 (not (Variables|Default|GetF6Pressed)))
    (if (Variables|Default|GetRegenActive)
      (Variables|Default|SetRegenEnd (- (Utilities|Time|GetGameTimeinSeconds) 1.0))
      (Development|PrintString :InString "DEV 5: Regen OFF" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff")
      (else
        (CallFunction|StartRegen self 120.0 240.0)
      (Development|PrintString :InString "DEV 5: Regen ON (2 min) - press 5 again to stop" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff"))))
  (Variables|Default|SetF6Pressed kF6)
  (bind kF7 (Game|Player|IsInputKeyDown pc "Six"))
  (if (and kF7 (not (Variables|Default|GetF7Pressed)))
    (if (Variables|Default|GetAdrenaline)
      (Utilities|Time|ClearTimerbyFunctionName :Object self :FunctionName "EndAdrenaline")
      (CallFunction|EndAdrenaline self)
      (Development|PrintString :InString "DEV 6: Adrenaline OFF" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff")
      (else
        (CallFunction|StartAdrenaline self 120.0)
      (Development|PrintString :InString "DEV 6: Adrenaline ON (2 min) - press 6 again to stop" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff"))))
  (Variables|Default|SetF7Pressed kF7)
  (bind kF8 (Game|Player|IsInputKeyDown pc "Seven"))
  (if (and kF8 (not (Variables|Default|GetF8Pressed)))
    (if (Variables|Default|GetHiding)
      (Utilities|Time|ClearTimerbyFunctionName :Object self :FunctionName "EndHide")
      (CallFunction|EndHide self)
      (Development|PrintString :InString "DEV 7: Hide OFF" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff")
      (else
        (CallFunction|StartHide self 120.0)
      (Development|PrintString :InString "DEV 7: Hide ON (2 min) - press 7 again to stop" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff"))))
  (Variables|Default|SetF8Pressed kF8)
  (bind kF9 (Game|Player|IsInputKeyDown pc "Eight"))
  (if (and (and kF9 (not (Variables|Default|GetF9Pressed))) (not (Variables|Default|GetMorphed)))
    (if (> (Class|BPHealthComponent|GetArmour (Variables|Default|GetHealthComponent)) 0.0)
      (Class|BPHealthComponent|SetArmour :self (Variables|Default|GetHealthComponent) :Armour 0.0)
      (Development|PrintString :InString "DEV 8: Armour OFF" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff")
      (else
        (Class|BPHealthComponent|AddArmour (Variables|Default|GetHealthComponent) 25.0)
      (Development|PrintString :InString "DEV 8: Armour +25 ON - press 8 again to remove" :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.000000,G=0.500000,B=1.000000,A=1.000000)" :Duration 2.5 :Key "DevBuff"))))
  (Variables|Default|SetF9Pressed kF9))
