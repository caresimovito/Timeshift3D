(fn StartHide (Duration)
  ; INVISIBILITY for Duration seconds (timer only - attacking does not break it, user 2026-10-23)
  (if (not (Variables|Default|GetHiding))
    (Variables|Default|SetHiding true)
    (for a (Actor|GetAllActorsOfClass :ActorClass "/Game/Timeshift/Enemies/BP_EnemyBase.BP_EnemyBase_C")
      (CallFunction|DimEnemy self a))
    (CallFunction|HideFXOn self)
    (Development|PrintString :InString "INVISIBLE - the dinosaurs can't see you" :bPrintToScreen true :bPrintToLog true :TextColor "(R=0.300000,G=1.000000,B=0.950000,A=1.000000)" :Duration 3.0 :Key "Hide"))
  (Utilities|Time|SetTimerbyFunctionName :Object self :FunctionName "EndHide" :Time Duration :bLooping false))
