(fn AlignWeaponsToGrip ()
  (bind mesh (Variables|Character|GetMesh))
  (bind grip (Transformation|GetSocketLocation mesh "grip_r"))
  (bind tip (Transformation|GetSocketLocation mesh "grip_tip_r"))
  (bind d (- tip grip))
  (bind idx (Variables|Default|GetCurrentWeaponIndex))
  (if (Variables|Default|GetMorphed)
    ; morphed into a dinosaur: its bite / horns / tail (StartMorph also sets AttackRange)
    (Variables|Default|SetAttackDamage (* (Variables|Default|GetMorphDmg) (select (Variables|Default|GetFuryActive) 2.0 1.0)))
    (Variables|Default|SetAttackCooldown (Variables|Default|GetMorphCooldown))
    (elif (== idx 1)
    (Variables|Default|SetAttackDamage (* 32.0 (select (Variables|Default|GetFuryActive) 2.0 1.0)))
    (Variables|Default|SetAttackCooldown 1.0)
    (elif (== idx 2)
      (Variables|Default|SetAttackDamage (* 14.0 (select (Variables|Default|GetFuryActive) 2.0 1.0)))
      (Variables|Default|SetAttackCooldown 0.7)
      (else
        ; spear 20 damage; empty-handed punches 10
        (Variables|Default|SetAttackDamage (* (select (Variables|Default|GetHasSpear) 20.0 10.0) (select (Variables|Default|GetFuryActive) 2.0 1.0)))
        (Variables|Default|SetAttackCooldown 0.6)))))
  ; throwing a stone / bola (left-handed, from the hip pouch): the spear swings out of the way - upright at his right side,
  ; still IN the right hand (a 30 cm offset looked like it floated, user 2026-10-22) - so the shaft no longer crosses the
  ; throwing arm (user 2026-10-21)
  (bind throwing (and (Variables|Default|GetIsRangedAttacking) (== idx 0)))
  (bind side (Transformation|GetActorRightVector self))
  (Variables|Default|SetSpearDir (Math|Interpolation|VInterpTo (Variables|Default|GetSpearDir) (Math|Vector|Normalize (select throwing (+ (* (Transformation|GetActorUpVector self) 0.92) (* side 0.38)) (select (and (Variables|Default|GetIsAttacking) (== idx 0)) (- (Transformation|GetSocketLocation mesh "hand_l") grip) d))) (Utilities|Time|GetWorldDeltaSeconds) 14.0))
  (Transformation|SetWorldLocation (Variables|Default|GetSpearMeshComponent) (select throwing (+ grip (* side 4.0)) grip))
  (Transformation|SetWorldRotation (Variables|Default|GetSpearMeshComponent) (Math|Rotator|MakeRotfromZ (Variables|Default|GetSpearDir)))
  (Transformation|SetWorldScale3D (Variables|Default|GetSpearMeshComponent) (Math|Vector|MakeVector 1.0 1.0 0.85))
  (Transformation|SetWorldLocation (Variables|Default|GetClubMeshComponent) (+ grip (* d 170.0)))
  (Transformation|SetWorldRotation (Variables|Default|GetClubMeshComponent) (Math|Rotator|MakeRotfromZ (* d -1.0)))
  (if (Variables|Default|GetHasTorch)
    (Transformation|SetWorldLocation (Variables|Default|GetTorchMeshComponent) grip)
    (Transformation|SetWorldRotation (Variables|Default|GetTorchMeshComponent) (Math|Rotator|MakeRotfromZ d))))
