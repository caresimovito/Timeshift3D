(fn EndMorph ()
  (Utilities|Time|ClearTimerbyFunctionName :Object self :FunctionName "MorphTick")
  (Variables|Default|SetMorphed false)
  (bind hc (Variables|Default|GetHealthComponent))
  (Class|BPHealthComponent|SetMaxArmour :self hc :MaxArmour (Variables|Default|GetSavedMaxArmour))
  (Class|BPHealthComponent|SetArmour :self hc :Armour (Variables|Default|GetSavedArmour))
  (Variables|Default|SetBaseWalkSpeed (Variables|Default|GetSavedBaseSpeed))
  (Variables|Default|SetAttackRange (Variables|Default|GetSavedAttackRange))
  (Components|Capsule|SetCapsuleSize :self (Variables|Character|GetCapsuleComponent) :InRadius (Variables|Default|GetSavedCapR) :InHalfHeight (Variables|Default|GetSavedCapH) :bUpdateOverlaps true)
  (Transformation|SetRelativeScale3D (Variables|Character|GetMesh) (Variables|Default|GetSavedMeshScale))
  (Rendering|SetVisibility (Variables|Default|GetMorphBody) false)
  (CallFunction|SetTorchHiddenForMorph self false)
  (Transformation|SetRelativeLocation (Variables|Components|GetFollowCamera) (Variables|Default|GetSavedCamLoc) false false)
  (Niagara|SpawnSystematLocation :SystemTemplate "/Game/Timeshift/Hazards/VFX/NS_RockDust.NS_RockDust" :Location (Transformation|GetActorLocation self) :Scale (Math|Vector|MakeVector 1.5 1.5 1.5))
  (Development|PrintString :InString "You change back" :bPrintToScreen true :bPrintToLog true :TextColor "(R=0.900000,G=0.700000,B=0.400000,A=1.000000)" :Duration 2.0 :Key "Morph"))
