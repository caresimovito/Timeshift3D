(fn RefreshStatus ()
  (bind g (Settings|GetGameUserSettings))
  (bind q (Settings|GetOverallScalabilityLevel g))
  (bind fl (Settings|GetFrameRateLimit g))
  (bind qs (select (== q 0) "LOW" (select (== q 1) "MEDIUM" (select (== q 2) "HIGH" (select (== q 3) "ULTRA" "CUSTOM")))))
  (bind fs (select (< fl 1.0) "UNLIMITED" (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Float|Truncate fl)) " FPS")))
  (bind vs (select (Settings|IsVSyncEnabled g) "ON" "OFF"))
  (bind ms (select (Utilities|Enum|Equal(Enum) (Settings|GetFullscreenMode g) (Utilities|Enum|LiteralenumEWindowMode "Windowed")) "WINDOWED" "FULLSCREEN"))
  (bind (rx ry) (Utilities|Struct|BreakIntPoint (Settings|GetScreenResolution g)))
  (bind (sn sv smin smax) (Settings|GetResolutionScaleInformation g))
  (bind rs (Utilities|String|Append (Utilities|String|Append (Utilities|String|ToString(Integer) rx) " x ") (Utilities|String|ToString(Integer) ry)))
  (bind ss (Utilities|String|Append (Utilities|String|ToString(Integer) (Math|Float|Round sv)) "%"))
  (bind s (Utilities|String|Append
            (Utilities|String|Append
              (Utilities|String|Append (Utilities|String|Append "NOW:  Quality " qs) (Utilities|String|Append "   |   Frame cap " fs))
              (Utilities|String|Append (Utilities|String|Append "   |   VSync " vs) (Utilities|String|Append "   |   " ms)))
            (Utilities|String|Append (Utilities|String|Append "   |   " rs) (Utilities|String|Append "   |   Render scale " ss))))
  (bind s2 (Utilities|String|Append s (Utilities|String|Append "   |   Difficulty " (CallFunction|DifficultyName self))))
  (Widget|SetText(Text) :self (Variables|WBP_Settings|GetStatus) :InText (Utilities|Text|ToText(String) s2)))
