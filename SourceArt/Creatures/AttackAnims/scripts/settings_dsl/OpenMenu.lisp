(fn OpenMenu ()
  (bind pc (Game|GetPlayerController 0))
  (Widget|SetVisibility (Variables|WBP_Settings|GetDim) "Visible")
  (Widget|SetVisibility (Variables|WBP_Settings|GetPanel) "Visible")
  (Game|SetGamePaused true)
  (Input|SetInputModeGameAndUI pc (Variables|WBP_Settings|GetBtnResume) "DoNotLock" false false)
  (Class|PlayerController|SetShowMouseCursor :self pc :bShowMouseCursor true)
  (Variables|Default|SetOpen true)
  (CallFunction|RefreshStatus self))
