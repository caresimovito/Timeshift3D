(fn PlayMove (Body Species Move)
  ; plays the chosen clip on the enemy's Body; returns its length (0 if nothing played)
  (if (Utilities|String|EqualExactly(String) Species "Raptor")
    (if (== Move 1)
      (Components|Animation|PlayAnimation :self Body :NewAnimToPlay "/Game/Timeshift/Enemies/Raptor/SK_Raptor_Anim_SK_Raptor_Pounce.SK_Raptor_Anim_SK_Raptor_Pounce" :bLooping false)
      (return 1.00))
    (if (== Move 2)
      (Components|Animation|PlayAnimation :self Body :NewAnimToPlay "/Game/Timeshift/Enemies/Raptor/SK_Raptor_Anim_SK_Raptor_TailSwipe.SK_Raptor_Anim_SK_Raptor_TailSwipe" :bLooping false)
      (return 1.10))
    (if (== Move 9)
      (Components|Animation|PlayAnimation :self Body :NewAnimToPlay "/Game/Timeshift/Enemies/Raptor/SK_Raptor_Anim_SK_Raptor_Roar.SK_Raptor_Anim_SK_Raptor_Roar" :bLooping false)
      (return 1.60)))
  (if (Utilities|String|EqualExactly(String) Species "Dilophosaurus")
    (if (== Move 1)
      (Components|Animation|PlayAnimation :self Body :NewAnimToPlay "/Game/Timeshift/Enemies/Dilophosaurus/SK_Dilophosaurus_Anim_SK_Dilophosaurus_Pounce.SK_Dilophosaurus_Anim_SK_Dilophosaurus_Pounce" :bLooping false)
