(fn MoveCount (Species)
  ; how many authored attack moves this species has (0 = none / flyer)
  (if (Utilities|String|EqualExactly(String) Species "Raptor")
    (return 5))
  (if (Utilities|String|EqualExactly(String) Species "Dilophosaurus")
    (return 5))
  (if (Utilities|String|EqualExactly(String) Species "Compy")
    (return 5))
  (if (Utilities|String|EqualExactly(String) Species "Caudipteryx")
    (return 5))
  (if (Utilities|String|EqualExactly(String) Species "Kulindadromeus")
    (return 3))
  (if (Utilities|String|EqualExactly(String) Species "RiverAmbusher")
    (return 4))
  (if (Utilities|String|EqualExactly(String) Species "Triceratops")
    (return 3))
  (if (Utilities|String|EqualExactly(String) Species "Psittacosaurus")
    (return 3))
  (if (Utilities|String|EqualExactly(String) Species "Archaeoceratops")
    (return 3))
  (if (Utilities|String|EqualExactly(String) Species "Parasaurolophus")
    (return 4))
  (if (Utilities|String|EqualExactly(String) Species "Spinosaurus")
    (return 4))
  (if (Utilities|String|EqualExactly(String) Species "Ankylosaurus")
    (return 4))
  (if (Utilities|String|EqualExactly(String) Species "Stegosaurus")
    (return 2))
  (return 0))
