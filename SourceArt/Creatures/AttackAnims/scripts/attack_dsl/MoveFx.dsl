(fn MoveFx (Active)
  ; runs every tick: fires the current move's hits at their times; a flinch / death / the move ending cancels the rest
  (if (not (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) ""))
    (if (not Active)
      (Variables|Default|SetCurMove "")
      (else
        (bind el (- (Utilities|Time|GetGameTimeinSeconds) (Variables|Default|GetMoveStart)))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Pounce")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.35))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.60 false 0.50 500.0 250.0 0 0)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "TailSwipe")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.45))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.40 true 0.40 750.0 250.0 1 2)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Charge")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.45))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 2.00 false 0.60 900.0 300.0 2 2)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Stomp")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.65))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.90 true 0.70 650.0 450.0 0 1)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Gore")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.52))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.40 false 0.50 300.0 800.0 2 0)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Frenzy")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.30))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.25 false 0.30 150.0 0.0 0 0))
          (if (and (== (Variables|Default|GetHitsDone) 1) (>= el 0.52))
            (Variables|Default|SetHitsDone 2)
            (CallFunction|Hit self 1.25 false 0.30 150.0 0.0 0 0))
          (if (and (== (Variables|Default|GetHitsDone) 2) (>= el 0.74))
            (Variables|Default|SetHitsDone 3)
            (CallFunction|Hit self 1.25 false 0.30 150.0 0.0 0 0)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Slash")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.35))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.25 false 0.35 250.0 100.0 0 0))
          (if (and (== (Variables|Default|GetHitsDone) 1) (>= el 0.52))
            (Variables|Default|SetHitsDone 2)
            (CallFunction|Hit self 1.25 false 0.35 250.0 100.0 0 0)
            (Variables|Default|SetCurMove "")))
        (if (Utilities|String|EqualExactly(String) (Variables|Default|GetCurMove) "Sidestep")
          (if (and (== (Variables|Default|GetHitsDone) 0) (>= el 0.55))
            (Variables|Default|SetHitsDone 1)
            (CallFunction|Hit self 1.50 true 0.40 350.0 150.0 0 0)
            (Variables|Default|SetCurMove "")))
))))
