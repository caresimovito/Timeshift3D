(fn StartBurst ()
  (Variables|Default|SetPhase 2)
  (Components|Activation|Deactivate (Variables|Default|GetWarn))
  (Components|Activation|Activate (Variables|Default|GetSteam) true)
  (Audio|PlaySoundatLocation :Sound "/Game/Timeshift/Hazards/Audio/S_GeyserBurst.S_GeyserBurst" :Location (Transformation|GetActorLocation self) :VolumeMultiplier 1.3 :PitchMultiplier (Math|Random|RandomFloatinRange 0.92 1.08))
  ; re-check the column 4x a second for the whole burst (anyone still in it or landing back in gets hit again, 1 s cooldown)
  (CallFunction|BurstTick self)
  (Utilities|Time|SetTimerbyFunctionName :Object self :FunctionName "BurstTick" :Time 0.25 :bLooping true)
  (Utilities|Time|SetTimerbyFunctionName :Object self :FunctionName "EndBurst" :Time (Variables|Default|GetBurstTime) :bLooping false))
