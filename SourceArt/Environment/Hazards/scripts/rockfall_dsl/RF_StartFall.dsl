(fn StartFall ()
  ; tell: a deep rumble and dust spilling off the cliff lip, then the rocks come down WarnTime later (no camera shake)
  (Variables|Default|SetBusy true)
  (Variables|Default|SetRocksLeft (Variables|Default|GetRockCount))
  (bind a (Variables|Default|GetLipA))
  (bind b (Variables|Default|GetLipB))
  (Audio|PlaySoundatLocation :Sound "/Game/Timeshift/Hazards/Audio/S_RockRumble.S_RockRumble" :Location (Math|Vector|MakeVector (* 0.5 (+ (.x a) (.x b))) (* 0.5 (+ (.y a) (.y b))) (* 0.5 (+ (.z a) (.z b)))) :VolumeMultiplier 1.6 :PitchMultiplier 1.0)
  (Niagara|SpawnSystematLocation :SystemTemplate "/Game/Timeshift/Hazards/VFX/NS_RockDust.NS_RockDust" :Location a :Scale (Math|Vector|MakeVector 1.6 1.6 1.6))
  (Niagara|SpawnSystematLocation :SystemTemplate "/Game/Timeshift/Hazards/VFX/NS_RockDust.NS_RockDust" :Location (Math|Vector|MakeVector (* 0.5 (+ (.x a) (.x b))) (* 0.5 (+ (.y a) (.y b))) (* 0.5 (+ (.z a) (.z b)))) :Scale (Math|Vector|MakeVector 1.8 1.8 1.8))
  (Niagara|SpawnSystematLocation :SystemTemplate "/Game/Timeshift/Hazards/VFX/NS_RockDust.NS_RockDust" :Location b :Scale (Math|Vector|MakeVector 1.6 1.6 1.6))
  (Utilities|Time|SetTimerbyFunctionName :Object self :FunctionName "StartDropping" :Time (Variables|Default|GetWarnTime) :bLooping false))
