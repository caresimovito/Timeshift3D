(fn StepFlight (Dt)
  ; scripted ballistic flight (no physics: the canopy hulls over the path would catch physics rocks)
  ; state goes through member vars - pure binds would be re-evaluated after SetActorLocation moves us
  (Variables|Default|SetStepDt (Math|Float|Min(Float) Dt 0.25))
  (Variables|Default|SetVel (Math|Vector|MakeVector (.x (Variables|Default|GetVel)) (.y (Variables|Default|GetVel)) (- (.z (Variables|Default|GetVel)) (* 980.0 (Variables|Default|GetStepDt)))))
  (bind loc (Transformation|GetActorLocation self))
  (Variables|Default|SetP (Math|Vector|MakeVector (+ (.x loc) (* (.x (Variables|Default|GetVel)) (Variables|Default|GetStepDt))) (+ (.y loc) (* (.y (Variables|Default|GetVel)) (Variables|Default|GetStepDt))) (+ (.z loc) (* (.z (Variables|Default|GetVel)) (Variables|Default|GetStepDt)))))
  (Transformation|SetActorLocation self (Variables|Default|GetP) false false)
  (Transformation|AddActorLocalRotation self (Math|Rotator|MakeRotator :Roll (* (.roll (Variables|Default|GetSpin)) (Variables|Default|GetStepDt)) :Pitch (* (.pitch (Variables|Default|GetSpin)) (Variables|Default|GetStepDt)) :Yaw (* (.yaw (Variables|Default|GetSpin)) (Variables|Default|GetStepDt))) false false)
  (CallFunction|CheckHurt self)
  (Variables|Default|SetGround (Class|BPRockfall|GroundAt :self (Variables|Default|GetSpawner) :X (.x (Variables|Default|GetP)) :Y (.y (Variables|Default|GetP))))
  (if (and (<= (- (.z (Variables|Default|GetP)) (Variables|Default|GetRadius)) (Variables|Default|GetGround)) (< (.z (Variables|Default|GetVel)) 0.0))
    (Transformation|SetActorLocation self (Math|Vector|MakeVector (.x (Variables|Default|GetP)) (.y (Variables|Default|GetP)) (+ (Variables|Default|GetGround) (Variables|Default|GetRadius))) false false)
    (CallFunction|Impact self (Math|Float|Absolute(Float) (.z (Variables|Default|GetVel))))
    (if (and (< (Variables|Default|GetBounces) 2) (> (Math|Float|Absolute(Float) (.z (Variables|Default|GetVel))) 280.0))
      (Variables|Default|SetVel (Math|Vector|MakeVector (* 0.55 (.x (Variables|Default|GetVel))) (* 0.55 (.y (Variables|Default|GetVel))) (* -0.3 (.z (Variables|Default|GetVel)))))
      (Variables|Default|SetBounces (+ (Variables|Default|GetBounces) 1))
      (else
        (Variables|Default|SetPhase 1)
        (Actor|SetLifeSpan self 12.0)))))
