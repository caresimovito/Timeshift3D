(fn Launch (Owner Target T)
  ; random boulder size / tumble, then the arc that lands it on Target after T seconds (g = 980 cm/s2)
  (Variables|Default|SetSpawner Owner)
  (Variables|Default|SetScale (Math|Random|RandomFloatinRange 0.22 0.42))
  (Transformation|SetActorScale3D self (Math|Vector|MakeVector (Variables|Default|GetScale) (Variables|Default|GetScale) (Variables|Default|GetScale)))
  (Variables|Default|SetRadius (* 75.0 (Variables|Default|GetScale)))
  (Transformation|SetActorRotation self (Math|Rotator|MakeRotator :Roll (Math|Random|RandomFloatinRange 0.0 360.0) :Pitch (Math|Random|RandomFloatinRange -80.0 80.0) :Yaw (Math|Random|RandomFloatinRange 0.0 360.0)) false)
  (Variables|Default|SetSpin (Math|Rotator|MakeRotator :Roll (Math|Random|RandomFloatinRange -300.0 300.0) :Pitch (Math|Random|RandomFloatinRange -300.0 300.0) :Yaw (Math|Random|RandomFloatinRange -200.0 200.0)))
  (bind p0 (Transformation|GetActorLocation self))
  (Variables|Default|SetVel (Math|Vector|MakeVector (/ (- (.x Target) (.x p0)) T) (/ (- (.y Target) (.y p0)) T) (+ (/ (- (+ (.z Target) (Variables|Default|GetRadius)) (.z p0)) T) (* 490.0 T))))
  (Variables|Default|SetPhase 0))
