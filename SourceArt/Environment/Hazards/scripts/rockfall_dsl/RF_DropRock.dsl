(fn DropRock ()
  ; one boulder per call: off a random point on the cliff lip, arcing onto the path near the hero (first two close, rest scattered)
  (if (<= (Variables|Default|GetRocksLeft) 0)
    (Utilities|Time|ClearTimerbyFunctionName :Object self :FunctionName "DropRock")
    (Utilities|Time|SetTimerbyFunctionName :Object self :FunctionName "Rearm" :Time (Variables|Default|GetCooldown) :bLooping false)
    (else
      (Variables|Default|SetRocksLeft (- (Variables|Default|GetRocksLeft) 1))
      (Variables|Default|SetSpread (select (>= (Variables|Default|GetRocksLeft) (- (Variables|Default|GetRockCount) 2)) 120.0 480.0))
      (Variables|Default|SetLipT (Math|Random|RandomFloatinRange 0.0 1.0))
      (bind a (Variables|Default|GetLipA))
      (bind b (Variables|Default|GetLipB))
      (Variables|Default|SetSpawnPos (Math|Vector|MakeVector (+ (.x a) (* (Variables|Default|GetLipT) (- (.x b) (.x a)))) (+ (.y a) (* (Variables|Default|GetLipT) (- (.y b) (.y a)))) (+ (+ (.z a) (* (Variables|Default|GetLipT) (- (.z b) (.z a)))) (Math|Random|RandomFloatinRange 0.0 90.0))))
      (bind ploc (Transformation|GetActorLocation (Game|GetPlayerCharacter 0)))
      (Variables|Default|SetTX (Math|Float|Clamp(Float) (+ (.x ploc) (Math|Random|RandomFloatinRange (- (Variables|Default|GetSpread)) (Variables|Default|GetSpread))) (Variables|Default|GetTXMin) (Variables|Default|GetTXMax)))
      (Variables|Default|SetTY (Math|Float|Clamp(Float) (+ (.y ploc) (Math|Random|RandomFloatinRange (* -0.7 (Variables|Default|GetSpread)) (* 0.7 (Variables|Default|GetSpread)))) (Variables|Default|GetTYMin) (Variables|Default|GetTYMax)))
      (bind gz (CallFunction|GroundAt self (Variables|Default|GetTX) (Variables|Default|GetTY)))
      (bind rock (Game|SpawnActorfromClass :Class "/Game/Timeshift/Hazards/BP_FallingRock.BP_FallingRock_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Variables|Default|GetSpawnPos))))
      (Class|BPFallingRock|Launch :self rock :Owner self :Target (Math|Vector|MakeVector (Variables|Default|GetTX) (Variables|Default|GetTY) gz) :T (Math|Random|RandomFloatinRange 1.1 1.5)))))
